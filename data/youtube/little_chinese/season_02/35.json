  },
  {
    "hanzi": "然后跟李连杰一起拍过照",
    "start": 1209.263652,
    "end": 1212.938672
  },
  { "hanzi": "赵对佛教很感兴趣", "start": 1214.666257, "end": 1218.348201 },
  {
    "hanzi": "我一直想找一个师傅皈依",
    "start": 1218.381945,
    "end": 1222.013382
  },
  { "hanzi": "但是过来七八天了", "start": 1222.041684, "end": 1225.506589 },
