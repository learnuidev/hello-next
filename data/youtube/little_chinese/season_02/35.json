  { "hanzi": "然后再拜个师傅", "start": 1251.031393, "end": 1254.207401 },
  { "hanzi": "念经的基础必须要学好", "start": 1254.236338, "end": 1256.804049 },
  { "hanzi": "自己学还是跟师傅学", "start": 1256.827709, "end": 1258.913557 },
