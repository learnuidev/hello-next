    "end": 1066.005856
  },
  { "hanzi": "刚刚买了门票", "start": 1109.403317, "end": 1112.81861 },
  { "hanzi": "一个人20块", "start": 1112.859792, "end": 1116.351885 },
  { "hanzi": "还有200押金", "start": 1116.394914, "end": 1118.543153 },
  { "hanzi": "他说是男女混浴", "start": 1118.594157, "end": 1122.643434 },
  { "hanzi": "因为是个疗养温泉", "start": 1122.67338, "end": 1125.589839 },
  { "hanzi": "还有些建议的旅店", "start": 1125.617809, "end": 1129.247447 },
