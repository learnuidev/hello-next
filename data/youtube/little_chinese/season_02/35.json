    "hanzi": "这个一根四五十块钱，一公斤",
    "start": 991.605965,
    "end": 994.707724
  },
  { "hanzi": "跟黄金一个价", "start": 994.737185, "end": 996.778424 },
  { "hanzi": "称金下来跟黄金一个价", "start": 996.814795, "end": 1001.142418 },
  {
    "hanzi": "这样挖完了他们就回去了",
    "start": 1002.598518,
    "end": 1005.108083
  },
  { "hanzi": "从山上采下来", "start": 1005.131905, "end": 1006.643518 },
  { "hanzi": "我们收购", "start": 1006.670864, "end": 1008.178405 },
  { "hanzi": "他们回家", "start": 1008.219636, "end": 1009.476296 },
  { "hanzi": "然后挖完了再去挖", "start": 1010.875491, "end": 1012.791981 },
  { "hanzi": "明天早上又去", "start": 1012.815854, "end": 1014.610607 },
  { "hanzi": "他们下午再过来", "start": 1014.637515, "end": 1015.775787 },
