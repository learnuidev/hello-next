  { "hanzi": "但是这是重要的收入", "start": 1050.483501, "end": 1052.707627 },
  { "hanzi": "让人们从高原谋生", "start": 1052.737254, "end": 1055.443095 },
  { "hanzi": "在世界屋脊上", "start": 1055.472045, "end": 1057.144214 },
  { "hanzi": "7点我们离开了帕里镇", "start": 1058.52176, "end": 1060.213646 },
  { "hanzi": "然后去康布温泉", "start": 1060.255069, "end": 1062.437616 },
