  { "hanzi": "就50", "start": 1162.841281, "end": 1164.311405 },
  { "hanzi": "现在开始下雪了", "start": 1164.340126, "end": 1167.843188 },
  { "hanzi": "天气太疯狂了", "start": 1167.874444, "end": 1170.475976 },
  { "hanzi": "你感觉咋样啊", "start": 1170.492707, "end": 1172.508146 },
  {
    "hanzi": "我感觉这个地方一点没有高反(开玩笑)",
