  { "hanzi": "在这里以物换物", "start": 685.474979, "end": 688.108006 },
  { "hanzi": "不需要签证", "start": 688.133368, "end": 690.441009 },
  { "hanzi": "但是五月太早了", "start": 690.466238, "end": 692.42234 },
  { "hanzi": "贸易六月份才开始", "start": 692.444668, "end": 695.547021 },
  {
    "hanzi": "它那是用一种古老的方法，马帮",
    "start": 695.585125,
    "end": 699.440262
  },
  { "hanzi": "就马帮？", "start": 699.46609, "end": 700.940742 },
  { "hanzi": "每天看到有时候", "start": 700.962241, "end": 703.107365 },
  { "hanzi": "马帮大的话五六十个马帮", "start": 703.145867, "end": 705.175434 },
  { "hanzi": "大概的话下个月", "start": 705.215297, "end": 707.873122 },
  { "hanzi": "下个月", "start": 707.900719, "end": 726.102011 },
  { "hanzi": "跟他们互换", "start": 726.137054, "end": 726.642732 },
  { "hanzi": "他们价格，和我们价格谈", "start": 726.681032, "end": 757.177867 },
  { "hanzi": "我们的地方直接", "start": 757.211361, "end": 758.557168 },
  { "hanzi": "山顶有路，他们那边没路", "start": 758.579784, "end": 760.411433 },
  {
    "hanzi": "不丹人过来的话要走几天啊？",
    "start": 760.448732,
    "end": 763.377993
  },
  {
    "hanzi": "他们走的，按规定是5天嘛",
    "start": 763.405474,
    "end": 766.242574
  },
  { "hanzi": "五天才能走到？", "start": 766.28641, "end": 769.11079 },
  { "hanzi": "这有什么都有", "start": 769.137707, "end": 770.735888 },
  { "hanzi": "从这边过来的", "start": 770.757758, "end": 773.212415 },
  { "hanzi": "那边牧场上住一个晚上", "start": 773.254199, "end": 776.010853 },
  { "hanzi": "然后过来", "start": 776.039015, "end": 777.34124 },
  { "hanzi": "那边沟里", "start": 777.375963, "end": 779.573133 },
  {
    "hanzi": "走路的话，一天就到他们首都廷布",
    "start": 779.600152,
    "end": 782.773057
  },
  { "hanzi": "哇，一天就到廷布了", "start": 782.800059, "end": 786.508149 },
  { "hanzi": "既然来了", "start": 787.012952, "end": 788.845663 },
  { "hanzi": "我们就逛逛", "start": 788.872245, "end": 791.702392 },
  { "hanzi": "这里就一条主街道", "start": 792.536568, "end": 795.707425 },
  { "hanzi": "他们在做", "start": 797.55384, "end": 799.635443 },
  { "hanzi": "一些藏式传统柜子", "start": 800.329149, "end": 803.843708 },
  {
    "hanzi": "我觉得在家里放个这个还挺有意思的",
    "start": 803.884416,
    "end": 807.678781
  },
  { "hanzi": "大哥你们就只是刷漆是吗", "start": 807.720251, "end": 810.71051 },
  {
    "hanzi": "不是，我们也画。彩绘也是你们画的",
    "start": 810.737585,
    "end": 814.843352
  },
  { "hanzi": "这些都是画的吗", "start": 814.885137, "end": 817.4776 },
  { "hanzi": "这个画一个要多长时间", "start": 817.501415, "end": 819.745403 },
  { "hanzi": "两三天吧", "start": 819.771418, "end": 822.390113 },
  {
    "hanzi": "我好像看不出可以装什么东西",
    "start": 822.41499,
    "end": 824.377785
  },
  { "hanzi": "它好像没门", "start": 824.42019, "end": 825.378596 },
  { "hanzi": "有门嘛？门在什么地方？", "start": 825.41885, "end": 827.912864 },
  { "hanzi": "这个，这里", "start": 831.054784, "end": 833.02562 },
  {
    "hanzi": "是不是要做个把手，把它拉开？",
    "start": 833.048442,
    "end": 835.44679
  },
  {
    "hanzi": "原来是这样的，还是个隐藏的",
    "start": 840.636985,
    "end": 844.511376
  },
  { "hanzi": "如果关上，根本看不出来", "start": 844.541798, "end": 847.443044 },
  { "hanzi": "和杨的", "start": 847.4797, "end": 849.302975 },
  { "hanzi": "这个设计很好", "start": 849.328343, "end": 851.577255 },
  { "hanzi": "这就是你们制作的过程", "start": 852.329136, "end": 854.876448 },
  { "hanzi": "那这个是在哪儿呢", "start": 857.409568, "end": 860.140937 },
  { "hanzi": "在庙里面嘛？", "start": 860.166747, "end": 862.173356 },
  { "hanzi": "就是你们也是木匠？", "start": 862.199027, "end": 865.1736 },
  { "hanzi": "他们木匠，你们是绘画的", "start": 865.39598, "end": 868.611115 },
  { "hanzi": "尼泊尔特色餐厅", "start": 869.930233, "end": 873.435804 },
  { "hanzi": "谢谢", "start": 883.662655, "end": 885.377975 },
  {
    "hanzi": "今天我点了尼泊尔蔬菜咖喱",
    "start": 891.380587,
    "end": 894.847454
  },
  { "hanzi": "还有米饭", "start": 894.885232, "end": 896.072706 },
  { "hanzi": "一份30元", "start": 896.099912, "end": 897.641408 },
  { "hanzi": "西藏可不便宜啊", "start": 897.677999, "end": 901.572555 },
  { "hanzi": "下午五点，虫草市场开始", "start": 911.54954, "end": 914.741313 },
  { "hanzi": "越来越多摩托车来到街上", "start": 914.777379, "end": 917.907705 },
  { "hanzi": "虫草只在", "start": 917.947277, "end": 919.905498 },
  { "hanzi": "在青藏高原有", "start": 919.932806, "end": 922.140487 },
  { "hanzi": "这个热带的真菌", "start": 922.166471, "end": 923.972935 },
  { "hanzi": "感染力蛾子的幼虫", "start": 924.000579, "end": 926.641024 },
  { "hanzi": "然后把他们变成了僵尸", "start": 926.676978, "end": 929.111211 },
  { "hanzi": "传统上，经常被当作灵药", "start": 929.147504, "end": 933.436612 },
  { "hanzi": "增强免疫", "start": 933.462632, "end": 935.04331 },
  { "hanzi": "需求很大", "start": 935.07844, "end": 937.242739 },
  { "hanzi": "让它成了最贵的寄生虫", "start": 937.282767, "end": 939.143438 },
  { "hanzi": "每克", "start": 939.183339, "end": 941.011061 },
  { "hanzi": "比黄金还贵", "start": 941.036785, "end": 943.478097 },
  { "hanzi": "最近每天，五六月份", "start": 943.503368, "end": 946.311218 },
  { "hanzi": "都有虫草交易", "start": 946.347198, "end": 949.859945 },
  { "hanzi": "虫草", "start": 949.882046, "end": 953.645245 },
  { "hanzi": "大部分骑着摩托车", "start": 953.68419, "end": 954.777701 },
  { "hanzi": "因为他们住在附近", "start": 954.803809, "end": 958.278107 },
  { "hanzi": "在周边区域", "start": 958.304394, "end": 959.643698 },
  { "hanzi": "他们从山上挖草", "start": 959.690775, "end": 964.577767 },
  { "hanzi": "(讨价还价 )", "start": 968.84532, "end": 973.210736 },
  {
    "hanzi": "大哥，那样一根多少钱啊？",
    "start": 975.673942,
    "end": 978.078579
  },
  { "hanzi": "55一根。", "start": 978.130067, "end": 979.477907 },
  { "hanzi": "4根220块钱", "start": 979.523078, "end": 981.970423 },
  { "hanzi": "一天就只挖到了四根？", "start": 981.998091, "end": 984.067621 },
  {
    "hanzi": "不是一个人，他一家人挖的",
    "start": 984.09743,
    "end": 985.535792
  },
  { "hanzi": "一家人只挖到了四根？", "start": 985.563559, "end": 987.734219 },
