    "end": 1139.008202
  },
  { "hanzi": "因为已经喘不过气了", "start": 1139.028109, "end": 1141.876463 },
  { "hanzi": "我们决定住一晚", "start": 1141.906836, "end": 1144.510689 },
  { "hanzi": "这是酒店房间", "start": 1144.534523, "end": 1147.443394 },
  { "hanzi": "这边住宿都这个条件", "start": 1147.471597, "end": 1150.510915 },
  { "hanzi": "一个房间三个床", "start": 1150.538692, "end": 1152.776038 },
  { "hanzi": "一晚上25一个人", "start": 1152.801297, "end": 1155.976917 },
  { "hanzi": "如果你有自己睡袋的话", "start": 1156.003727, "end": 1159.476818 },
  { "hanzi": "就25", "start": 1159.498993, "end": 1160.343542 },
