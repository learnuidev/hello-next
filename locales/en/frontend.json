  "(unauth)_privacy_page": {
    "h1": "Privacy",
    "p": "Please note that these Privacy were last revised on August 16st, 2025",
    "h2": "General",
    "p_1": "We care about your privacy. This policy explains how we collect, use,\n          and share your information when you use Mandarino’s websites, apps,\n          and services. By using them, you agree to this policy.",
    "h2_1": "Information we collect",
